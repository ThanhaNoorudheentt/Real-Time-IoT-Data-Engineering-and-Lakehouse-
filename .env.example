# Generate a local .env with `make init-env`; these example values are not production secrets.
# MinIO root is used only by the bucket/user bootstrap service.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_WAREHOUSE_USER=warehouse_app
MINIO_WAREHOUSE_PASSWORD=change_this_warehouse_password

# Grafana
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# MQTT identities (ACLs restrict simulator to publish and bridge to subscribe)
MQTT_SIMULATOR_USER=simulator
MQTT_SIMULATOR_PASSWORD=change_this_simulator_password
MQTT_BRIDGE_USER=bridge
MQTT_BRIDGE_PASSWORD=change_this_bridge_password

# CO2 alert threshold in ppm
CO2_THRESHOLD=1500

# PostgreSQL - Iceberg JDBC catalog
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=postgres